{
  "name": "arbeitssuche",
  "version": "0.1.13",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "bump": "npx tsx scripts/bump-version.ts",
    "crawl:download": "npx tsx scripts/crawl-download.ts",
    "fix": "knip --fix && eslint . --fix && prettier . --write",
    "verify": "prettier . --check && knip && depcruise src && jscpd && eslint . && electron-vite build",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:crawler": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npx playwright test --config=e2e/playwright.electron.config.ts",
    "test:e2e:update": "npx playwright test --config=e2e/playwright.electron.config.ts --update-snapshots",
    "test:all": "npm test && npm run test:crawler && npm run test:e2e",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typia/unplugin": "^12.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "cheerio": "^1.2.0",
    "dependency-cruiser": "^16.10.2",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unslop": "^0.2.1",
    "jscpd": "^4.0.8",
    "jsdom": "^29.0.1",
    "knip": "^6.2.0",
    "pdf-to-img": "^5.0.0",
    "playwright": "^1.49.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.58.0",
    "typia": "^12.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.96.1",
    "@types/turndown": "^5.0.6",
    "electron-store": "^11.0.2",
    "handlebars": "^4.7.9",
    "turndown": "^7.2.2"
  }
}
